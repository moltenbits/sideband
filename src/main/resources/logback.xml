<configuration>

    <!-- Logs go to stderr so stdout stays reserved for machine-readable command output. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- In the native image Flyway gets its migrations precomputed at build time; its classpath scanner still
         reports the location it cannot scan, which is noise on every first contact with a database. -->
    <logger name="org.flywaydb.core.internal.scanner" level="error" />

    <root level="warn">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
